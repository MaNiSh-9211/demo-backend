# demo-backend/.env — committed safe defaults (dev-only service)

JWT_SECRET=CHANGE_ME_JWT_SECRET
PASSWORD_PEPPER=CHANGE_ME_PASSWORD_PEPPER

PORT=8080
AUTH_DEV_TOKENS=1
EXPECTED_ISSUER=api-gateway-auth-server
EXPECTED_AUDIENCE=api-gateway-clients
BCRYPT_COST=12
USER_STORE_PATH=/app/data/users.json
SERVICE_REGION=
